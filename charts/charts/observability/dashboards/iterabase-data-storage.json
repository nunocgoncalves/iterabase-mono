          "displayMode": "table",
          "placement": "right",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(((longhorn_node_storage_capacity_bytes - longhorn_node_storage_usage_bytes - longhorn_node_storage_reservation_bytes) / longhorn_node_storage_capacity_bytes) or ((longhorn_disk_capacity_bytes - longhorn_disk_usage_bytes - longhorn_disk_reservation_bytes) / longhorn_disk_capacity_bytes))",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": false,
          "instant": true
        }
      ]
    },
