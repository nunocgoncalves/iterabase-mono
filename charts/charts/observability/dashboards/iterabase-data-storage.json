          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"control-plane|inference-gateway|postgresql|redis|minio|.*dcgm-exporter.*\"}, namespace)",
          "refId": "VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
