{
  "schema_version": 3,
  "targets": {
    "control-plane": {
      "version_file": "control-plane/VERSION",
      "tag_prefix": "control-plane-v",
      "images": [
        {
          "name": "control-plane",
          "repository": "ghcr.io/nunocgoncalves/control-plane",
          "context": "control-plane",
          "dockerfile": "control-plane/Dockerfile"
        },
        {
          "name": "control-plane-harness",
          "repository": "ghcr.io/nunocgoncalves/control-plane-harness",
          "context": "control-plane/harness",
          "dockerfile": "control-plane/harness/Dockerfile"
        },
        {
          "name": "control-plane-tool-runner",
          "repository": "ghcr.io/nunocgoncalves/control-plane-tool-runner",
          "context": "control-plane/tool-runner",
          "dockerfile": "control-plane/tool-runner/Dockerfile"
        }
      ]
    },
    "inference-gateway": {
      "version_file": "inference-gateway/VERSION",
      "tag_prefix": "inference-gateway-v",
      "images": [
        {
          "name": "inference-gateway",
          "repository": "ghcr.io/nunocgoncalves/inference-gateway",
          "context": "inference-gateway",
          "dockerfile": "inference-gateway/Dockerfile"
        }
      ]
    },
    "forge": {
      "version_file": "forge/VERSION",
      "tag_prefix": "forge-v",
      "images": []
    },
    "control-plane-chart": {
      "chart": "control-plane",
      "tag_prefix": "control-plane-",
      "images": []
    },
    "inference-gateway-chart": {
      "chart": "inference-gateway",
      "tag_prefix": "inference-gateway-",
      "images": []
    },
    "iterabase-platform-chart": {
      "chart": "iterabase-platform",
      "tag_prefix": "iterabase-platform-",
      "images": [],
      "companions": ["cert-manager-substrate", "rwx-storage-substrate"]
    }
  }
}
