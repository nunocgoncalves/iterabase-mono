{
  "schema_version": 4,
  "artifact_recipes": {
    "control-plane-image": {
      "kind": "image",
      "target": "control-plane",
      "name": "control-plane",
      "repository": "ghcr.io/nunocgoncalves/control-plane",
      "context": "control-plane",
      "dockerfile": "control-plane/Dockerfile",
      "paths": ["control-plane/**"],
      "build_args": ["VERSION={version}", "COMMIT={source_sha}"],
      "labels": ["org.opencontainers.image.version={version}", "org.opencontainers.image.revision={source_sha}", "org.opencontainers.image.source=https://github.com/{repository}"]
    },
    "harness-image": {
      "kind": "image",
      "target": "control-plane",
      "name": "control-plane-harness",
      "repository": "ghcr.io/nunocgoncalves/control-plane-harness",
      "context": "control-plane/harness",
      "dockerfile": "control-plane/harness/Dockerfile",
      "paths": ["control-plane/harness/**", "control-plane/proto/**"],
      "build_args": ["VERSION={version}", "COMMIT={source_sha}"],
      "labels": ["org.opencontainers.image.version={version}", "org.opencontainers.image.revision={source_sha}", "org.opencontainers.image.source=https://github.com/{repository}"]
    },
    "tool-runner-image": {
      "kind": "image",
      "target": "control-plane",
      "name": "control-plane-tool-runner",
      "repository": "ghcr.io/nunocgoncalves/control-plane-tool-runner",
      "context": "control-plane/tool-runner",
      "dockerfile": "control-plane/tool-runner/Dockerfile",
      "paths": ["control-plane/tool-runner/**", "control-plane/proto/**"],
      "build_args": ["VERSION={version}", "COMMIT={source_sha}"],
      "labels": ["org.opencontainers.image.version={version}", "org.opencontainers.image.revision={source_sha}", "org.opencontainers.image.source=https://github.com/{repository}"]
    },
    "inference-gateway-image": {
      "kind": "image",
      "target": "inference-gateway",
      "name": "inference-gateway",
      "repository": "ghcr.io/nunocgoncalves/inference-gateway",
      "context": "inference-gateway",
      "dockerfile": "inference-gateway/Dockerfile",
      "paths": ["inference-gateway/**"],
      "build_args": ["VERSION={version}", "COMMIT={source_sha}"],
      "labels": ["org.opencontainers.image.version={version}", "org.opencontainers.image.revision={source_sha}", "org.opencontainers.image.source=https://github.com/{repository}"]
    },
    "runtime-fixture-image": {
      "kind": "image",
      "temporary_only": true,
      "name": "control-plane-runtime-fixture",
      "repository": "iterabase-e2e/control-plane-runtime-fixture",
      "context": "control-plane/test/e2e/fixtures/runtime",
      "dockerfile": "control-plane/test/e2e/fixtures/runtime/Dockerfile",
      "paths": ["control-plane/test/e2e/fixtures/runtime/**"],
      "build_args": ["COMMIT={source_sha}"],
      "labels": ["org.opencontainers.image.revision={source_sha}", "org.opencontainers.image.source=https://github.com/{repository}"]
    },
    "control-plane-chart": {
      "kind": "chart",
      "target": "control-plane-chart",
      "chart": "control-plane",
      "dependency_builds": ["control-plane", "observability", "cert-manager-substrate", "iterabase-platform"],
      "paths": ["charts/charts/control-plane/**"]
    },
    "inference-gateway-chart": {
      "kind": "chart",
      "target": "inference-gateway-chart",
      "chart": "inference-gateway",
      "dependency_builds": ["control-plane", "observability", "cert-manager-substrate", "iterabase-platform"],
      "paths": ["charts/charts/inference-gateway/**"]
    },
    "iterabase-platform-chart": {
      "kind": "chart",
      "target": "iterabase-platform-chart",
      "chart": "iterabase-platform",
      "companions": ["cert-manager-substrate"],
      "dependency_builds": ["control-plane", "observability", "cert-manager-substrate", "iterabase-platform"],
      "paths": ["charts/**"]
    },
    "cert-manager-substrate-chart": {
      "kind": "chart-companion",
      "target": "iterabase-platform-chart",
      "chart": "cert-manager-substrate",
      "dependency_builds": ["control-plane", "observability", "cert-manager-substrate", "iterabase-platform"],
      "paths": ["charts/charts/cert-manager-substrate/**"]
    },
    "forge-binary": {
      "kind": "forge",
      "target": "forge",
      "paths": ["forge/**"],
      "goreleaser_config": "forge/.goreleaser.yaml",
      "goreleaser_version": "v2.12.7",
      "platforms": ["linux_amd64", "linux_arm64", "darwin_amd64", "darwin_arm64"]
    },
    "certificate-migration-chart": {
      "kind": "published-chart",
      "reference": "oci://ghcr.io/nunocgoncalves/iterabase-charts/iterabase-platform:0.2.2"
    },
    "supported-platform-predecessor": {
      "kind": "published-chart",
      "reference": "oci://ghcr.io/nunocgoncalves/iterabase-charts/iterabase-platform:0.3.12",
      "checksum": "86b0f23012fb549e47b2afb19b16184c760adcd6fe930bc3d817e031f1d280dd"
    },
    "supported-substrate-predecessor": {
      "kind": "published-chart",
      "reference": "oci://ghcr.io/nunocgoncalves/iterabase-charts/cert-manager-substrate:0.3.12",
      "checksum": "979eb26fbb5fa08a345929c59f5379b03f053f3ba0a66169bf2e84c5c919a67b"
    },
    "metallb-platform-predecessor": {
      "kind": "published-chart",
      "reference": "oci://ghcr.io/nunocgoncalves/iterabase-charts/iterabase-platform:0.3.19",
      "checksum": "252e5fea513c998eb04cfa75408ebc6d216831778cb96dfe23176ede5f6e76ff"
    },
    "metallb-substrate-predecessor": {
      "kind": "published-chart",
      "reference": "oci://ghcr.io/nunocgoncalves/iterabase-charts/cert-manager-substrate:0.3.19",
      "checksum": "437e5ab1e244261e7011fe369e7a59323ed628588e07e2dc5204531e867a5481"
    }
  },
  "published_baselines": {
    "control-plane-image": "ghcr.io/nunocgoncalves/control-plane:0.0.30",
    "harness-image": "ghcr.io/nunocgoncalves/control-plane-harness:0.0.30",
    "tool-runner-image": "ghcr.io/nunocgoncalves/control-plane-tool-runner:0.0.30",
    "inference-gateway-image": "ghcr.io/nunocgoncalves/inference-gateway:0.2.7",
    "control-plane-chart": "oci://ghcr.io/nunocgoncalves/iterabase-charts/control-plane:0.4.12",
    "inference-gateway-chart": "oci://ghcr.io/nunocgoncalves/iterabase-charts/inference-gateway:0.2.13",
    "iterabase-platform-chart": "oci://ghcr.io/nunocgoncalves/iterabase-charts/iterabase-platform:0.3.22",
    "cert-manager-substrate-chart": "oci://ghcr.io/nunocgoncalves/iterabase-charts/cert-manager-substrate:0.3.22",
    "forge-binary": "https://github.com/nunocgoncalves/iterabase-mono/releases/download/forge-v0.8.5/forge_0.8.5_linux_amd64.tar.gz"
  },
  "targets": {
    "control-plane": {
      "version_file": "control-plane/VERSION",
      "tag_prefix": "control-plane-v",
      "artifacts": ["control-plane-image", "harness-image", "tool-runner-image"]
    },
    "inference-gateway": {
      "version_file": "inference-gateway/VERSION",
      "tag_prefix": "inference-gateway-v",
      "artifacts": ["inference-gateway-image"]
    },
    "forge": {
      "version_file": "forge/VERSION",
      "tag_prefix": "forge-v",
      "artifacts": ["forge-binary"]
    },
    "control-plane-chart": {
      "chart": "control-plane",
      "tag_prefix": "control-plane-",
      "artifacts": ["control-plane-chart"]
    },
    "inference-gateway-chart": {
      "chart": "inference-gateway",
      "tag_prefix": "inference-gateway-",
      "artifacts": ["inference-gateway-chart"]
    },
    "iterabase-platform-chart": {
      "chart": "iterabase-platform",
      "tag_prefix": "iterabase-platform-",
      "artifacts": ["iterabase-platform-chart", "cert-manager-substrate-chart"]
    }
  }
}
