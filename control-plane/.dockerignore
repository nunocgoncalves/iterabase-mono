# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include embedded SQL migrations (go:embed in internal/database)
!**/*.sql

# Re-include the embedded common-password blocklist (go:embed in internal/identity)
!internal/identity/common_passwords.txt

# Dashboard source is built in its own Node stage, then copied into the Go
# builder for embedding. Local dependencies/build output never enter context.
!ui/**
ui/node_modules/**
ui/dist/**
